# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni o'zingiz yozing.
# ".env" faylini hech qachon GitHub'ga yoki boshqalarga yubormang!

# Owner akkaunti (server ishga tushganda yaratiladi / yangilanadi).
# Telefon raqami o'zbekcha formatda: 998901234567
OWNER_PHONE=99 485 86 86
# Kamida 8 belgi. Kuchli, noyob parol tanlang.
OWNER_PASSWORD=Sherzod.X

PORT=3000
# Faqat shu kompyuterdan kirish uchun 127.0.0.1. Tarmoqqa ochish uchun 0.0.0.0
HOST=127.0.0.1

# Internetga HTTPS bilan joylashtirganda: production
NODE_ENV=development

# Ixtiyoriy: 64 ta hex belgi (telefonlarni shifrlash kaliti). Bo'sh qolsa data/secret.key avtomatik yaratiladi.
DATA_KEY=
